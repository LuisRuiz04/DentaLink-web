include _ui

doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    meta(name="color-scheme" content="light dark")
    title Acceso · DentaLink
    script.
      (function(){try{var t=localStorage.getItem('dl-theme');if(!t)t=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';document.documentElement.dataset.theme=t}catch(e){}})()
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap")
    link(rel="stylesheet" href="/css/style.css?v=8")
    script(src="/js/app.js?v=8")
    script(src="/js/steps.js?v=8" defer)

  body
    main.auth
      section.auth__brand
        img(src="/img/logo.png" alt="DentaLink" width="440" height="199")
        div
          h1 Gestión clínica integral para odontólogos modernos.
          p Controla tu agenda, expedientes digitales, odontogramas interactivos, historial fotográfico y recetas médicas en una sola plataforma diseñada para tu consultorio.
        p.muted(style="font-size: 13px") DentaLink © 2026. Todos los derechos reservados.

      section.auth__panel
        button.icon-btn.auth__theme(type="button" data-theme-toggle aria-label="Cambiar modo claro u oscuro" title="Modo claro / oscuro")
          span.theme-btn
            span.i-sun
              +icon('sun', 19)
            span.i-moon
              +icon('moon', 19)

        .auth__card
          img.auth__logo-sm(src="/img/logo.png" alt="DentaLink" width="160" height="72")
          header
            h2 ¡Bienvenido de nuevo!
            p.muted Ingresa a tu cuenta o registra tu consultorio.

          if error == '1'
            .alert.alert--error(role="alert")
              strong ¡Ups! 
              | Correo o contraseña incorrectos.
          if error == '2'
            .alert.alert--warn(role="alert")
              strong Error del servidor. 
              | Inténtalo de nuevo más tarde.

          .seg#seg(data-mode="login" role="tablist")
            span.seg__thumb
            button#tab-login(type="button" role="tab" data-mode="login" aria-selected="true") Iniciar sesión
            button#tab-signup(type="button" role="tab" data-mode="signup" aria-selected="false") Registrarse

          form.form#form-login(action="/login" method="POST")
            +field('Correo electrónico', 'email', { type: 'email', placeholder: 'doctor@dentalink.com', required: true, autocomplete: 'email' })
            label.field
              span.field__label Contraseña
              .pw
                input.input(type="password" name="password" placeholder="••••••••" required autocomplete="current-password")
                button(type="button" data-reveal aria-label="Mostrar contraseña")
                  +icon('eye', 18)
            button.btn.btn--primary.btn--block(type="submit" style="height: 46px") Entrar al sistema

          form.form.hidden#form-signup(action="/registro" method="POST" data-steps data-submit="Crear cuenta y consultorio")
            .step(data-q="¿Quién eres?")
              +field('Nombre completo del doctor', 'nombre_doctor', { placeholder: 'Dr. Luis Hernández', required: true })
              +field('Cédula profesional', 'cedula', { placeholder: 'Ej. 7845123', required: true })
            .step(data-q="¿Cómo es tu consultorio?")
              +field('Nombre de la clínica', 'nombre_clinica', { placeholder: 'Clínica Sonrisa', required: true })
              +field('Teléfono del consultorio', 'telefono', { type: 'tel', placeholder: 'Ej. 452 123 4567', required: true })
              +field('Dirección del consultorio', 'direccion', { placeholder: 'Av. Principal #123, Uruapan', required: true })
            .step(data-q="Crea tu acceso")
              +field('Correo electrónico', 'email', { type: 'email', placeholder: 'doctor@dentalink.com', required: true, autocomplete: 'email' })
              label.field
                span.field__label Contraseña
                .pw
                  input.input(type="password" name="password" placeholder="Mínimo 8 caracteres" required minlength="8" autocomplete="new-password")
                  button(type="button" data-reveal aria-label="Mostrar contraseña")
                    +icon('eye', 18)

    script.
      (function () {
        var seg = document.getElementById('seg');
        var forms = { login: document.getElementById('form-login'), signup: document.getElementById('form-signup') };
        seg.addEventListener('click', function (e) {
          var b = e.target.closest('button[data-mode]');
          if (!b) return;
          var mode = b.dataset.mode;
          seg.dataset.mode = mode;
          seg.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-selected', String(x === b)); });
          forms.login.classList.toggle('hidden', mode !== 'login');
          forms.signup.classList.toggle('hidden', mode !== 'signup');
          var f = forms[mode].querySelector('input'); if (f) f.focus();
        });
        document.addEventListener('click', function (e) {
          var r = e.target.closest('[data-reveal]');
          if (!r) return;
          var i = r.parentElement.querySelector('input');
          var show = i.type === 'password';
          i.type = show ? 'text' : 'password';
          r.setAttribute('aria-label', show ? 'Ocultar contraseña' : 'Mostrar contraseña');
        });
      })();
