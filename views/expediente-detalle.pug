extends layout

block content
  - var ini = ((paciente.nombre || '').charAt(0) + (paciente.apellidos || '').charAt(0)).toUpperCase()
  .page
    a.back(href="/expediente" data-prefetch)
      +icon('arrow-left', 16)
      | Pacientes

    .card
      .profile
        span.avatar.avatar--lg= ini
        .profile__data
          h1 #{paciente.nombre} #{paciente.apellidos}
          .meta
            if paciente.telefono
              span
                +icon('phone', 15)
                | #{paciente.telefono}
            if paciente.correo
              span
                +icon('mail', 15)
                | #{paciente.correo}
            if paciente.direccion
              span
                +icon('map-pin', 15)
                | #{paciente.direccion}
        .row-actions
          +btnEditarPaciente(paciente, true)
          a.btn.btn--ghost(href=`/mensajes?paciente=${paciente.id}` data-prefetch)
            +icon('message', 16)
            | Mensaje
          a.btn.btn--ghost(href=`/odontograma?paciente=${paciente.id}` data-prefetch)
            +icon('smile', 16)
            | Odontograma
          button.btn.btn--ghost(type="button" data-wizard data-paciente-id=paciente.id data-paciente-nombre=(paciente.nombre + ' ' + paciente.apellidos))
            +icon('calendar', 16)
            | Agendar cita
          button.btn.btn--primary(type="button" data-open="modalNota")
            +icon('plus', 16)
            | Nueva nota

    h2.section-title Historial clínico
    if notas && notas.length
      ol.timeline
        each nota in notas
          li
            article.card.note
              time(datetime=new Date(nota.createdAt).toISOString())= new Date(nota.createdAt).toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'America/Mexico_City' })
              p= nota.nota
    else
      .card.empty
        +icon('clipboard', 44)
        strong Sin notas todavía
        span Registra tratamientos, cambios de arco o cualquier incidencia de este paciente.
        button.btn.btn--primary(type="button" data-open="modalNota") Escribir la primera nota

block modals
  +modal('modalNota', 'Nueva nota clínica', { wide: true })
    form.form(action="/expediente/nota/nueva" method="POST" data-toast="Nota guardada" data-steps data-fresh data-submit="Guardar nota")
      input(type="hidden" name="pacienteId" value=paciente.id)
      .step(data-q="¿Qué se hizo en esta visita?" data-hint="Por ejemplo: cambio de arco a .018, resina en pieza 16.")
        +field('Nota', 'nota', { type: 'textarea', rows: 5, placeholder: 'Escribe la nota aquí', required: true })

  +modalEditarPaciente('detalle')
