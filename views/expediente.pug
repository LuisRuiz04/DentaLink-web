extends layout

block content
  - var lista = (pacientes || []).slice().sort(function (a, b) { return (a.nombre || '').localeCompare(b.nombre || '', 'es') })
  .page
    header.page-head
      div
        h1.page-title Pacientes
        p.page-sub Expedientes clínicos y odontogramas de cada paciente.
      button.btn.btn--primary(type="button" data-open="modalNuevoPaciente")
        +icon('plus', 18)
        | Nuevo paciente

    .card.card--flush
      if lista.length
        .toolbar
          label.search
            +icon('search', 18)
            input#filtro(type="search" placeholder="Buscar por nombre, teléfono o correo" autocomplete="off" aria-label="Buscar paciente")
          span.count#conteo= lista.length + (lista.length === 1 ? ' paciente' : ' pacientes')
        .table-wrap
          table.table
            thead
              tr
                th Paciente
                th Teléfono
                th.col-actions Acciones
            tbody#tabla
              each p in lista
                tr(data-q=((p.nombre || '') + ' ' + (p.apellidos || '') + ' ' + (p.telefono || '') + ' ' + (p.correo || '')).toLowerCase())
                  td
                    a.person(href=`/expediente/detalle?paciente=${p.id}` data-prefetch)
                      span.avatar.avatar--soft= ((p.nombre || '').charAt(0) + (p.apellidos || '').charAt(0)).toUpperCase()
                      span
                        strong #{p.nombre} #{p.apellidos}
                        small= p.correo
                  td= p.telefono
                  td.col-actions
                    .row-actions
                      +btnEditarPaciente(p)
                      a.btn.btn--ghost.btn--sm(href=`/expediente/detalle?paciente=${p.id}` data-prefetch) Expediente
                      a.btn.btn--soft.btn--sm(href=`/odontograma?paciente=${p.id}` data-prefetch) Odontograma
        #sinResultados.empty.hidden
          +icon('search', 44)
          strong Sin resultados
          span Prueba con otro nombre, teléfono o correo.
      else
        .empty
          +icon('users', 44)
          strong Aún no tienes pacientes
          span Registra al primero para crear su expediente y su odontograma.
          button.btn.btn--primary(type="button" data-open="modalNuevoPaciente") Registrar paciente

  script.
    (() => {
      DL.ready(() => {
        const input = document.getElementById('filtro');
        if (!input) return;
        const filas = Array.from(document.querySelectorAll('#tabla tr'));
        const conteo = document.getElementById('conteo');
        const vacio = document.getElementById('sinResultados');
        const limpiar = (s) => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
        input.addEventListener('input', () => {
          const q = limpiar(input.value.trim());
          let n = 0;
          filas.forEach((tr) => {
            const ok = !q || limpiar(tr.dataset.q).includes(q);
            tr.classList.toggle('is-hidden', !ok);
            if (ok) n++;
          });
          conteo.textContent = n + (n === 1 ? ' paciente' : ' pacientes');
          vacio.classList.toggle('hidden', n > 0);
        });
      });
    })();

block modals
  +modal('modalNuevoPaciente', 'Nuevo paciente', { wide: true })
    form.form(action="/pacientes/nuevo" method="POST" data-toast="Paciente registrado" data-steps data-fresh data-submit="Guardar paciente")
      .step(data-q="¿Cómo se llama el paciente?")
        +field('Nombre(s)', 'nombre', { placeholder: 'Ej. Abraham', required: true })
        +field('Apellidos', 'apellidos', { placeholder: 'Ej. Raúl', required: true })
      .step(data-q="¿Cómo lo contactamos?")
        +field('Teléfono', 'telefono', { type: 'tel', placeholder: '10 dígitos', required: true })
        +field('Dirección', 'direccion', { placeholder: 'Calle y número', required: true })
      .step(data-q="Su acceso a la app móvil" data-hint="Con este correo y contraseña el paciente entra a la app.")
        +field('Correo electrónico', 'correo', { type: 'email', placeholder: 'correo@ejemplo.com', required: true })
        +field('Contraseña de la app', 'password', { type: 'password', placeholder: 'Mínimo 6 caracteres', required: true, minlength: 6, autocomplete: 'new-password' })

  +modalEditarPaciente('lista')
