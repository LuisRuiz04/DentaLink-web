extends layout

block content
  .contenido(style="padding: 30px; font-family: 'Inter', sans-serif; background-color: #f1f5f9; min-height: calc(100vh - 60px);")
    .encabezado-de-pagina(style="display: flex; justify-content: space-between; margin-bottom: 30px;")
      .titulo-y-descripcion
        h1(style="font-size: 26px; font-weight: 700; color: #1e293b; margin: 0 0 8px 0;") Emisión de Recetas
        p(style="color: #64748b; margin: 0; font-size: 15px;") Crea indicaciones claras y profesionales para tus pacientes.

    .layout-receta(style="display: grid; grid-template-columns: 450px 1fr; gap: 30px; align-items: start;")
      
      // PANEL IZQUIERDO: FORMULARIO (Estilo Tarjeta)
      .panel-izquierdo(style="background: white; padding: 30px; border-radius: 16px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);")
        
        // 1. Selección de Paciente
        div(style="margin-bottom: 30px;")
          label(style="font-weight: 600; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; color: #00A5C4; display: block; margin-bottom: 12px;") 1. Datos del Paciente
          select#pacienteSelect(style="width: 100%; padding: 12px 15px; border: 1px solid #cbd5e1; border-radius: 10px; font-size: 14px; background-color: #f8fafc; color: #1e293b; outline: none; cursor: pointer; transition: all 0.3s;")
            option(value="" disabled selected) -- Selecciona al paciente --
            if pacientes
              each paciente in pacientes
                option(value=paciente.id) #{paciente.nombre} #{paciente.apellidos}

        div(style="border-bottom: 1px dashed #cbd5e1; margin-bottom: 30px;")
        
        // 2. Formulario de Medicamentos
        div(style="margin-bottom: 25px;")
          label(style="font-weight: 600; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; color: #00A5C4; display: block; margin-bottom: 5px;") 2. Prescripción Médica
          p(style="font-size: 13px; color: #64748b; margin-bottom: 20px; margin-top: 0;") Completa los campos para añadir a la receta.
          
          div(style="display: flex; flex-direction: column; gap: 16px; margin-bottom: 20px;")
            div
              label(style="font-size: 13px; font-weight: 600; color: #475569; display: block; margin-bottom: 6px;") Medicamento
              input#medNombre(type="text" placeholder="Ej. Amoxicilina" style="width: 100%; padding: 12px; border: 1px solid #e2e8f0; border-radius: 10px; background-color: #f8fafc; box-sizing: border-box; font-size: 14px; outline: none; transition: border 0.3s;")
            
            div
              label(style="font-size: 13px; font-weight: 600; color: #475569; display: block; margin-bottom: 6px;") Dosis y Presentación
              input#medDosis(type="text" placeholder="Ej. 500 mg - 1 cápsula" style="width: 100%; padding: 12px; border: 1px solid #e2e8f0; border-radius: 10px; background-color: #f8fafc; box-sizing: border-box; font-size: 14px; outline: none; transition: border 0.3s;")
            
            div
              label(style="font-size: 13px; font-weight: 600; color: #475569; display: block; margin-bottom: 6px;") Frecuencia e Indicaciones
              input#medFrecuencia(type="text" placeholder="Ej. Cada 8 horas por 7 días" style="width: 100%; padding: 12px; border: 1px solid #e2e8f0; border-radius: 10px; background-color: #f8fafc; box-sizing: border-box; font-size: 14px; outline: none; transition: border 0.3s;")
              
          button(type="button" onclick="agregarMedicamentoUI()" style="width: 100%; padding: 14px; background: #ecfdf5; border: 1px solid #10b981; color: #10b981; font-weight: 600; border-radius: 10px; font-size: 14px; cursor: pointer; transition: all 0.2s;") + Agregar a la receta

      // PANEL DERECHO: VISTA PREVIA (Estilo Hoja Flotante)
      .panel-derecho(style="background: #e2e8f0; padding: 40px; border-radius: 16px; display: flex; flex-direction: column; align-items: center;")
        
        // El "Papel" de la receta
        #hojaPreview(style="background: white; width: 100%; max-width: 550px; min-height: 400px; border-radius: 8px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04); padding: 40px; position: relative;")
          
          div(style="border-bottom: 2px solid #00A5C4; padding-bottom: 15px; margin-bottom: 20px;")
            h3(style="font-size: 18px; margin: 0; color: #1e293b;") Vista previa de medicamentos
            p(style="margin: 5px 0 0 0; font-size: 12px; color: #64748b;") El diseño final del PDF incluirá tu logotipo y firma.

          // Contenedor dinámico donde se verán los medicamentos
          #listaVistaPrevia(style="flex-grow: 1;")
            p#placeholderTexto(style="color: #94a3b8; text-align: center; margin-top: 80px; font-style: italic;") El recetero está vacío. <br> Agrega medicamentos para comenzar.

        // Botón Final debajo de la hoja
        button(type="button" onclick="enviarReceta()" style="margin-top: 30px; width: 100%; max-width: 550px; padding: 16px; background: #00A5C4; color: white; border: none; font-weight: bold; border-radius: 10px; font-size: 16px; cursor: pointer; box-shadow: 0 4px 6px rgba(0, 165, 196, 0.3); transition: all 0.3s;") Generar y Descargar PDF

    // LOGICA JAVASCRIPT DEL FRONTEND
    script.
      let listaMeds = [];

      // Efecto focus bonito para los inputs
      document.querySelectorAll('input').forEach(input => {
        input.addEventListener('focus', (e) => { e.target.style.border = '1px solid #00A5C4'; e.target.style.backgroundColor = '#ffffff'; });
        input.addEventListener('blur', (e) => { e.target.style.border = '1px solid #e2e8f0'; e.target.style.backgroundColor = '#f8fafc'; });
      });

      function agregarMedicamentoUI() {
          const nombre = document.getElementById('medNombre').value;
          const dosis = document.getElementById('medDosis').value;
          const frecuencia = document.getElementById('medFrecuencia').value;

          if(!nombre || !dosis || !frecuencia) {
              alert("Por favor completa todos los campos del medicamento.");
              return;
          }

          listaMeds.push({ nombre, dosis, frecuencia });

          document.getElementById('medNombre').value = '';
          document.getElementById('medDosis').value = '';
          document.getElementById('medFrecuencia').value = '';

          renderizarVistaPrevia();
      }

      function renderizarVistaPrevia() {
          const contenedor = document.getElementById('listaVistaPrevia');
          
          if(listaMeds.length === 0) {
              contenedor.innerHTML = '<p id="placeholderTexto" style="color: #94a3b8; text-align: center; margin-top: 80px; font-style: italic;">El recetero está vacío. <br> Agrega medicamentos para comenzar.</p>';
              return;
          }

          let html = '<h2 style="margin-top:0; font-size: 28px; color: #00A5C4; font-weight: 800;">Rx</h2>';
          listaMeds.forEach((med, index) => {
              html += `
                <div style="margin-bottom: 20px; padding-bottom: 20px; border-bottom: 1px dashed #e2e8f0;">
                  <p style="margin: 0; font-weight: 700; color: #1e293b; font-size: 15px;">${index + 1}. ${med.nombre} - <span style="font-weight: 500; color: #475569;">${med.dosis}</span></p>
                  <p style="margin: 6px 0 0 0; color: #64748b; font-size: 13px; line-height: 1.5;">${med.frecuencia}</p>
                </div>
              `;
          });
          contenedor.innerHTML = html;
      }

      function enviarReceta() {
          const pacienteId = document.getElementById('pacienteSelect').value;
          
          if(!pacienteId) {
              alert("Selecciona al paciente para emitir la receta.");
              return;
          }
          if(listaMeds.length === 0) {
              alert("Debes agregar al menos un medicamento.");
              return;
          }

          fetch('/receta/generar', {
              method: 'POST',
              headers: {
                  'Content-Type': 'application/json'
              },
              body: JSON.stringify({ pacienteId, medicamentos: listaMeds })
          })
          .then(res => res.json())
          .then(data => {
              if (data.success) {
                  window.open(data.url_pdf, '_blank');
                  listaMeds = [];
                  renderizarVistaPrevia();
                  document.getElementById('pacienteSelect').value = '';
              } else {
                  alert("Error al generar la receta.");
              }
          })
          .catch(err => console.error(err));
      }