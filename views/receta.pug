extends layout

block content
  - var fechaReceta = new Date().toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Mexico_City' })
  - var nomDoc = (doctor && doctor.nombre_doctor) || ''
  - var nomDocMostrado = /^dra?\.?\s/i.test(nomDoc) ? nomDoc : 'Dr. ' + nomDoc
  .page
    header.page-head
      div
        h1.page-title Recetas
        p.page-sub Crea indicaciones claras y profesionales para tus pacientes.

    .receta
      section.card#rxCard
        .sf__head
          .wiz__meta
            strong#rxTxt Faltan 2 preguntas
            span#rxPct 0%
          .wiz__bar
            span#rxFill

        .rx-step.is-active
          h3.step__q ¿Para quién es la receta?
          label.field
            span.field__label Paciente
            select.input#pacienteSelect
              option(value="" disabled selected) Elige un paciente
              each p in (pacientes || [])
                option(value=p.id)= p.nombre + ' ' + p.apellidos

        .rx-step
          h3.step__q ¿Qué medicamentos le recetas?
          p.step__hint Agrega uno por uno; aparecen en la hoja de la derecha.
          +field('Medicamento', '', { id: 'medNombre', placeholder: 'Ej. Amoxicilina' })
          +field('Dosis y presentación', '', { id: 'medDosis', placeholder: 'Ej. 500 mg, 1 cápsula' })
          +field('Frecuencia e indicaciones', '', { id: 'medFrecuencia', placeholder: 'Ej. Cada 8 horas por 7 días' })
          button.btn.btn--soft.btn--block#btnAgregar(type="button")
            +icon('plus', 16)
            | Agregar a la receta
          #medsLista.meds(style="margin-top: 0")

        .rx-step
          h3.step__q Revisa y genera la receta
          p.step__hint Si algo no es correcto, usa “Cambiar”.
          .wiz__sum#rxSum

        .sf__foot
          button.btn.btn--ghost.is-gone#rxBack(type="button") Atrás
          button.btn.btn--primary#rxNext(type="button") Continuar
          button.btn.btn--primary.hidden#btnGenerar(type="button")
            +icon('file-text', 18)
            | Generar y descargar PDF

      section.stage
        .paper
          .paper__head
            div
              h3= clinicaActiva ? clinicaActiva.nombre_clinica : 'DentaLink'
              if clinicaActiva
                p #{clinicaActiva.direccion}
                p Tel. #{clinicaActiva.telefono}
            div(style="text-align: right")
              h3= nomDocMostrado
              if doctor && doctor.cedula
                p Cédula prof. #{doctor.cedula}
          .paper__who
            span Paciente: 
              strong#papelPaciente Sin seleccionar
            span= fechaReceta
          .paper__rx Rx
          #listaVistaPrevia.paper__list
            p.paper__empty El recetero está vacío.<br>Agrega medicamentos para comenzar.
          .paper__sign Firma del médico

  script.
    (() => {
      DL.ready(() => {
        const $ = (s) => document.getElementById(s);
        const meds = [];
        const pasos = Array.from(document.querySelectorAll('#rxCard .rx-step'));
        const VACIO = '<p class="paper__empty">El recetero está vacío.<br>Agrega medicamentos para comenzar.</p>';
        const sel = $('pacienteSelect');
        let paso = 0;

        const pintar = () => {
          $('listaVistaPrevia').innerHTML = meds.length
            ? meds.map((m, i) => `<div class="paper__item"><b>${i + 1}. ${DL.esc(m.nombre)}</b> ${DL.esc(m.dosis)}<p>${DL.esc(m.frecuencia)}</p></div>`).join('')
            : VACIO;
          $('medsLista').innerHTML = meds.map((m, i) => `
            <div class="med"><div><strong>${DL.esc(m.nombre)}</strong><span>${DL.esc(m.dosis)}, ${DL.esc(m.frecuencia)}</span></div>
            <button type="button" class="icon-btn icon-btn--sm icon-btn--danger" data-quitar="${i}" aria-label="Quitar ${DL.esc(m.nombre)}">
              <svg class="icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button></div>`).join('');
        };
        const nombrePaciente = () => (sel.selectedIndex > 0 ? sel.options[sel.selectedIndex].text : 'Sin seleccionar');

        const resumen = () => {
          const fila = (etq, val, ir) => `<div class="wiz__row"><div><small>${etq}</small><strong class="sf__val">${val}</strong></div><button type="button" class="btn btn--ghost btn--sm" data-ir="${ir}">Cambiar</button></div>`;
          $('rxSum').innerHTML = fila('Paciente', DL.esc(nombrePaciente()), 0)
            + fila(`Medicamentos (${meds.length})`, meds.map((m, i) => `${i + 1}. ${DL.esc(m.nombre)} ${DL.esc(m.dosis)}, ${DL.esc(m.frecuencia)}`).join('<br>'), 1);
        };

        const ir = (i, dir) => {
          paso = Math.max(0, Math.min(2, i));
          if (paso === 2) resumen();
          pasos.forEach((p, k) => { p.classList.toggle('is-active', k === paso); p.classList.remove('sf-fwd', 'sf-back'); });
          if (dir) { const c = pasos[paso]; void c.offsetWidth; c.classList.add(dir > 0 ? 'sf-fwd' : 'sf-back'); }
          const falta = 2 - paso;
          $('rxTxt').textContent = paso === 2 ? '¡Listo! Revisa y confirma' : (falta === 1 ? 'Última pregunta' : `Faltan ${falta} preguntas`);
          const pct = paso === 2 ? 100 : paso * 50;
          $('rxPct').textContent = pct + '%';
          $('rxFill').style.transform = `scaleX(${Math.max(pct, 4) / 100})`;
          $('rxBack').classList.toggle('is-gone', paso === 0);
          $('rxNext').classList.toggle('hidden', paso === 2);
          $('btnGenerar').classList.toggle('hidden', paso !== 2);
          if (dir && paso === 1) setTimeout(() => $('medNombre').focus({ preventScroll: true }), 60);
        };

        const siguiente = () => {
          if (paso === 0 && !sel.value) return DL.toast('Selecciona al paciente.', 'error');
          if (paso === 1 && !meds.length) {
            if ($('medNombre').value.trim()) { agregar(); if (!meds.length) return; }
            else return DL.toast('Agrega al menos un medicamento.', 'error');
          }
          ir(paso + 1, 1);
        };

        function agregar() {
          const nombre = $('medNombre').value.trim(), dosis = $('medDosis').value.trim(), frecuencia = $('medFrecuencia').value.trim();
          if (!nombre || !dosis || !frecuencia) return DL.toast('Completa los tres campos del medicamento.', 'error');
          meds.push({ nombre, dosis, frecuencia });
          ['medNombre', 'medDosis', 'medFrecuencia'].forEach((id) => { $(id).value = ''; });
          pintar();
          $('medNombre').focus();
        }

        $('btnAgregar').addEventListener('click', agregar);
        ['medNombre', 'medDosis', 'medFrecuencia'].forEach((id, k, arr) => $(id).addEventListener('keydown', (e) => {
          if (e.key !== 'Enter') return;
          e.preventDefault();
          if (k < arr.length - 1) $(arr[k + 1]).focus(); else agregar();
        }));
        $('medsLista').addEventListener('click', (e) => {
          const b = e.target.closest('[data-quitar]');
          if (b) { meds.splice(Number(b.dataset.quitar), 1); pintar(); }
        });
        sel.addEventListener('change', () => {
          $('papelPaciente').textContent = nombrePaciente();
          if (paso === 0) setTimeout(siguiente, 190);
        });
        $('rxNext').addEventListener('click', siguiente);
        $('rxBack').addEventListener('click', () => ir(paso - 1, -1));
        $('rxSum').addEventListener('click', (e) => { const b = e.target.closest('[data-ir]'); if (b) ir(Number(b.dataset.ir), -1); });

        const pre = new URLSearchParams(location.search).get('paciente');
        if (pre) {
          sel.value = pre;
          if (sel.selectedIndex > 0) { $('papelPaciente').textContent = nombrePaciente(); ir(1, 0); }
        }

        $('btnGenerar').addEventListener('click', async function () {
          const btn = this;
          btn.classList.add('is-busy');
          try {
            const r = await fetch('/receta/generar', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pacienteId: sel.value, medicamentos: meds }) });
            const data = await r.json();
            if (!data.success) throw new Error();
            window.location.href = '/receta/descargar/' + data.id;   // descarga el PDF sin salir de la página
            meds.length = 0; pintar();
            sel.selectedIndex = 0; $('papelPaciente').textContent = 'Sin seleccionar';
            ir(0, -1);
            DL.toast('Receta generada');
          } catch (err) {
            DL.toast('No se pudo generar la receta.', 'error');
          } finally { btn.classList.remove('is-busy'); }
        });
      });
    })();
