extends layout

block content
  - var fotos = [['Frontal en oclusión', 'Intraoral', '12 ago 2025'], ['Oclusal superior', 'Intraoral', '12 ago 2025'], ['Oclusal inferior', 'Intraoral', '12 ago 2025'], ['Lateral derecha', 'Intraoral', '12 ago 2025'], ['Lateral izquierda', 'Intraoral', '12 ago 2025'], ['Panorámica dental', 'Radiografía', '12 ago 2025'], ['Periapical, pieza 16', 'Radiografía', '12 ago 2025'], ['Aleta de mordida', 'Radiografía', '28 ene 2025']]
  .page
    header.page-head
      div
        h1.page-title Historial fotográfico
        p.page-sub Imágenes clínicas para documentar cada etapa del tratamiento.
      button.btn.btn--primary(type="button" disabled title="Próximamente")
        +icon('plus', 18)
        | Subir fotos

    .card(style="margin-bottom: 20px")
      .toolbar(style="border: 0; padding: 0")
        .chips
          button.chip(type="button" data-t="todas" aria-pressed="true") Todas
          button.chip(type="button" data-t="Intraoral" aria-pressed="false") Intraorales
          button.chip(type="button" data-t="Radiografía" aria-pressed="false") Radiografías
        span.badge.badge--warn.count Vista de ejemplo, aún sin fotos reales

    .gallery#galeria
      each f in fotos
        article.card.shot(data-t=f[1])
          .shot__img
            +icon('image', 36)
          strong= f[0]
          .sub= f[2]

  script.
    (() => {
      DL.ready(() => {
        const chips = document.querySelectorAll('.chip[data-t]');
        chips.forEach((c) => c.addEventListener('click', () => {
          chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
          document.querySelectorAll('#galeria .shot').forEach((s) => s.classList.toggle('is-hidden', c.dataset.t !== 'todas' && s.dataset.t !== c.dataset.t));
        }));
      });
    })();
