extends layout

block content
  - var items = productos || []
  - var cats = categoriasUnicas || []
  - var esBajo = function (p) { return Number(p.cantidad) <= Number(p.stock_minimo) }
  - var bajo = items.filter(esBajo).length
  .page
    header.page-head
      div
        h1.page-title Inventario
        p.page-sub Mantén tus insumos al día y el consultorio siempre preparado.
      button.btn.btn--primary(type="button" data-open="modalNuevoProducto")
        +icon('plus', 18)
        | Nuevo producto

    if items.length
      .stats
        .card.stat
          span.stat__ico
            +icon('package', 22)
          div
            strong= items.length
            span Productos
        .card.stat
          span.stat__ico(class=(bajo ? 'stat__ico--danger' : ''))
            +icon('alert', 22)
          div
            strong= bajo
            span Con bajo stock
        .card.stat
          span.stat__ico
            +icon('clipboard', 22)
          div
            strong= cats.length
            span Categorías

    .card.card--flush
      if items.length
        .toolbar
          label.search
            +icon('search', 18)
            input#filtro(type="search" placeholder="Buscar por nombre o categoría" autocomplete="off" aria-label="Buscar producto")
          .chips
            button.chip(type="button" data-f="todos" aria-pressed="true") Todos
            button.chip(type="button" data-f="bajo" aria-pressed="false") Bajo stock
          span.count#conteo= items.length + (items.length === 1 ? ' producto' : ' productos')
        .table-wrap
          table.table
            thead
              tr
                th Producto
                th Cantidad
                th Estado
                th.col-actions Acciones
            tbody#tabla
              each p in items
                - var b = esBajo(p)
                tr(data-q=((p.nombre || '') + ' ' + (p.categoria || '') + ' ' + (p.descripcion || '')).toLowerCase() data-bajo=(b ? '1' : '0'))
                  td
                    strong #{p.nombre}
                    .sub #{p.categoria || 'Sin categoría'}#{p.descripcion ? ', ' + p.descripcion : ''}
                    .sub INV-#{String(p.id).padStart(3, '0')}
                  td
                    form.stepper(action=`/inventario/ajustar-stock/${p.id}` method="POST" data-toast="Cantidad actualizada")
                      button.stepper__btn(type="button" data-step="-1" aria-label="Restar uno")
                        +icon('minus', 14)
                      input(type="number" name="cantidad" value=p.cantidad min="0" data-original=p.cantidad aria-label=`Cantidad de ${p.nombre}`)
                      button.stepper__btn(type="button" data-step="1" aria-label="Sumar uno")
                        +icon('plus', 14)
                      button.btn.btn--soft.btn--sm.save(type="submit")
                        +icon('check', 14)
                        | Guardar
                  td
                    if b
                      span.badge.badge--danger.badge--dot Bajo stock
                    else
                      span.badge.badge--ok.badge--dot Suficiente
                  td.col-actions
                    .row-actions
                      button.icon-btn.icon-btn--primary(type="button" aria-label=`Editar ${p.nombre}` title="Editar" data-open="modalEditarProducto" data-id=p.id data-nombre=p.nombre data-categoria=(p.categoria || '') data-descripcion=(p.descripcion || '') data-cantidad=p.cantidad data-stock_minimo=p.stock_minimo)
                        +icon('pencil', 17)
                      form(action=`/inventario/eliminar/${p.id}` method="POST" data-confirm=`¿Eliminar «${p.nombre}»? Esta acción no se puede deshacer.` data-confirm-ok="Eliminar producto" data-toast="Producto eliminado")
                        button.icon-btn.icon-btn--danger(type="submit" aria-label=`Eliminar ${p.nombre}` title="Eliminar")
                          +icon('trash', 17)
        #sinResultados.empty.hidden
          +icon('search', 44)
          strong Sin resultados
          span Prueba con otro nombre o quita el filtro de bajo stock.
      else
        .empty
          +icon('package', 44)
          strong Aún no tienes productos
          span Agrega tus insumos para llevar el control de existencias y recibir alertas de bajo stock.
          button.btn.btn--primary(type="button" data-open="modalNuevoProducto") Agregar producto

  datalist#listaCategorias
    each c in cats
      option(value=c)

  script.
    (() => {
      DL.ready(() => {
        const tabla = document.getElementById('tabla');
        if (!tabla) return;
        const filas = Array.from(tabla.querySelectorAll('tr'));
        const filtro = document.getElementById('filtro');
        const conteo = document.getElementById('conteo');
        const vacio = document.getElementById('sinResultados');
        const chips = document.querySelectorAll('.chip[data-f]');
        let modo = 'todos';
        const limpiar = (s) => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

        const aplicar = () => {
          const q = limpiar(filtro.value.trim());
          let n = 0;
          filas.forEach((tr) => {
            const ok = (!q || limpiar(tr.dataset.q).includes(q)) && (modo === 'todos' || tr.dataset.bajo === '1');
            tr.classList.toggle('is-hidden', !ok);
            if (ok) n++;
          });
          conteo.textContent = n + (n === 1 ? ' producto' : ' productos');
          vacio.classList.toggle('hidden', n > 0);
        };
        filtro.addEventListener('input', aplicar);
        chips.forEach((c) => c.addEventListener('click', () => {
          modo = c.dataset.f;
          chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
          aplicar();
        }));

        // Botones - / + : el botón "Guardar" aparece solo cuando la cantidad cambió
        const revisar = (input) => input.closest('.stepper').classList.toggle('is-dirty', input.value !== input.dataset.original);
        tabla.addEventListener('click', (e) => {
          const b = e.target.closest('[data-step]');
          if (!b) return;
          const input = b.parentElement.querySelector('input');
          input.value = Math.max(0, (parseInt(input.value, 10) || 0) + Number(b.dataset.step));
          revisar(input);
        });
        tabla.addEventListener('input', (e) => { if (e.target.matches('.stepper input')) revisar(e.target); });
      });
    })();

block modals
  +modal('modalNuevoProducto', 'Nuevo producto')
    form.form(action="/inventario/nuevo" method="POST" data-toast="Producto agregado" data-steps data-fresh data-submit="Agregar producto")
      .step(data-q="¿Qué producto es?")
        +field('Nombre del producto', 'nombre', { placeholder: 'Ej. Resina compuesta A2', required: true })
        +field('Categoría', 'categoria', { placeholder: 'Ej. Restauración', list: 'listaCategorias', autocomplete: 'off' })
        +field('Descripción', 'descripcion', { placeholder: 'Ej. Jeringa de 4 g' })
      .step(data-q="¿Cuántas unidades tienes?" data-hint="Te avisaremos cuando la cantidad llegue al stock mínimo.")
        +field('Cantidad actual', 'cantidad', { type: 'number', value: '0', min: 0, required: true })
        +field('Stock mínimo (alerta)', 'stock_minimo', { type: 'number', value: '5', min: 0, required: true })

  +modal('modalEditarProducto', 'Editar producto')
    form.form(method="POST" data-action="/inventario/editar/{id}" data-toast="Cambios guardados" data-steps data-submit="Guardar cambios")
      .step(data-q="¿Qué producto es?")
        +field('Nombre del producto', 'nombre', { required: true, fill: 'nombre' })
        +field('Categoría', 'categoria', { list: 'listaCategorias', autocomplete: 'off', fill: 'categoria' })
        +field('Descripción', 'descripcion', { fill: 'descripcion' })
      .step(data-q="¿Cuántas unidades tienes?" data-hint="Te avisaremos cuando la cantidad llegue al stock mínimo.")
        +field('Cantidad actual', 'cantidad', { type: 'number', min: 0, required: true, fill: 'cantidad' })
        +field('Stock mínimo', 'stock_minimo', { type: 'number', min: 0, required: true, fill: 'stock_minimo' })
