include _ui

- var activa = (typeof pagina !== 'undefined' && pagina) || ''
- var nombreDoc = (doctor && doctor.nombre_doctor) || ''
- var nombreMostrado = /^dra?\.?\s/i.test(nombreDoc) ? nombreDoc : 'Dr. ' + nombreDoc
- var iniciales = nombreDoc.replace(/^dra?\.?\s+/i, '').split(/\s+/).filter(Boolean).slice(0, 2).map(function (p) { return p[0] }).join('').toUpperCase() || 'Dr'
- var hoyTxt = new Date().toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'America/Mexico_City' })
- var TITULOS = { agenda: 'Agenda', pacientes: 'Pacientes', expediente: 'Pacientes', odontograma: 'Odontograma', inventario: 'Inventario', recetas: 'Recetas', historial: 'Historial fotográfico', mensajes: 'Mensajes', citas: 'Citas' }
- var navItems = [{ href: '/', label: 'Agenda', icon: 'calendar', match: '/citas /consulta', exact: true, keys: ['agenda'] }, { href: '/mensajes', label: 'Mensajes', icon: 'message', match: '/mensajes', keys: ['mensajes'], badge: true }, { href: '/expediente', label: 'Pacientes', icon: 'users', match: '/expediente /odontograma', keys: ['pacientes', 'expediente', 'odontograma'] }, { href: '/inventario', label: 'Inventario', icon: 'package', match: '/inventario', keys: ['inventario'] }, { href: '/receta', label: 'Recetas', icon: 'file-text', match: '/receta', keys: ['recetas'] }]

doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    meta(name="color-scheme" content="light dark")
    title= (TITULOS[activa] ? TITULOS[activa] + ' · ' : '') + 'DentaLink'
    //- El tema se aplica ANTES de pintar para que no haya destello blanco al abrir en modo oscuro.
    script.
      (function(){try{var t=localStorage.getItem('dl-theme');if(!t)t=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';document.documentElement.dataset.theme=t}catch(e){}})()
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap")
    link(rel="stylesheet" href="/css/style.css?v=8")
    script(src="/js/app.js?v=8")
    script(src="/js/wizard.js?v=8" defer)
    script(src="/js/steps.js?v=8" defer)
    script(src="/js/mensajes.js?v=8" defer)

  body
    a.skip(href="#vista") Saltar al contenido
    #progress(aria-hidden="true")

    .app
      aside#sidebar.sidebar
        a.brand(href="/" aria-label="DentaLink, ir a la agenda")
          img(src="/img/logo.png" alt="DentaLink" width="150" height="68")

        #clinica-switch.clinica-switch(data-sync)
          button.clinica(type="button" data-toggle="menuClinicas" aria-haspopup="true")
            +icon('building', 20)
            span.clinica__txt
              strong= clinicaActiva ? clinicaActiva.nombre_clinica : 'Sin clínica'
              small Cambiar consultorio
            +icon('chevron-down', 16)
          #menuClinicas.menu
            each c in (misClinicas || [])
              - var esActiva = clinicaActiva && clinicaActiva.id === c.id
              .menu__row
                a.menu__item(href=`/cambiar-clinica/${c.id}` class=(esActiva ? 'is-active' : '') data-clinica-id=c.id)
                  span= c.nombre_clinica
                  if esActiva
                    +icon('check', 16)
                button.icon-btn.icon-btn--sm(type="button" data-open="modalEditarClinica" data-id=c.id data-nombre=c.nombre_clinica data-telefono=c.telefono data-direccion=c.direccion aria-label=`Editar ${c.nombre_clinica}`)
                  +icon('pencil', 15)
            button.menu__item.menu__item--accent(type="button" data-open="modalNuevaClinica")
              +icon('plus', 16)
              | Registrar nueva clínica

        nav.nav(aria-label="Principal")
          p.nav__title Espacio clínico
          each it in navItems
            a.nav__item(href=it.href data-match=it.match data-exact=it.exact data-prefetch aria-current=(it.keys.indexOf(activa) > -1 ? 'page' : undefined))
              +icon(it.icon, 20)
              span= it.label
              if it.badge
                span.nav__badge#badgeMensajes(hidden aria-label="mensajes sin leer")

        p.sidebar__foot DentaLink · Gestión clínica integral

      .scrim(data-nav-close)

      .main
        header.topbar
          button.icon-btn.only-mobile(type="button" data-nav-toggle aria-label="Abrir menú")
            +icon('menu', 20)
          p.topbar__date#hoy= hoyTxt
          .spacer
          button.btn.btn--primary.btn--sm.topbar__new(type="button" data-wizard)
            +icon('plus', 16)
            span Nueva cita
          button.icon-btn.theme-btn(type="button" data-theme-toggle aria-label="Cambiar modo claro u oscuro" title="Modo claro / oscuro")
            span.i-sun
              +icon('sun', 19)
            span.i-moon
              +icon('moon', 19)
          #perfil.perfil(data-sync)
            button.perfil__btn(type="button" data-toggle="menuPerfil" aria-haspopup="true")
              span.avatar= iniciales
              span.perfil__txt
                strong= nombreMostrado
                small Odontólogo
              +icon('chevron-down', 16)
            #menuPerfil.menu.menu--right
              button.menu__item(type="button" data-open="modalPerfil")
                +icon('user', 16)
                | Mi perfil
              a.menu__item.menu__item--danger(href="/cerrar-sesion" data-native)
                +icon('log-out', 16)
                | Cerrar sesión

        main#vista(tabindex="-1")
          block content

    //- Ventanas propias de cada vista (fuera de #vista para que sigan fijas a la pantalla)
    #vista-extras
      block modals

    //- Ventanas globales
    //- Asistente "Nueva cita" (pregunta por pregunta). El contenido lo dibuja /js/wizard.js
    #wizCita.modal(role="dialog" aria-modal="true" aria-labelledby="wizStepTxt" aria-hidden="true")
      .modal__box.modal__box--wide.wiz
        header.wiz__head
          button.icon-btn#wizBack(type="button" aria-label="Pregunta anterior")
            +icon('chevron-left', 20)
          .wiz__progress
            .wiz__meta
              strong#wizStepTxt Nueva cita
              span#wizPct 0%
            .wiz__bar
              span#wizBarFill
          button.icon-btn(type="button" data-close aria-label="Cerrar")
            +icon('x', 18)
        #wizBody.wiz__body
        #wizFoot.wiz__foot.hidden

    +modal('modalNuevaClinica', 'Registrar consultorio')
      form.form(action="/clinica/nueva" method="POST" data-toast="Consultorio creado" data-steps data-fresh data-submit="Crear consultorio")
        .step(data-q="¿Cómo se llama el consultorio?")
          +field('Nombre de la clínica', 'nombre_clinica', { placeholder: 'Ej. Consultorio Centro', required: true })
        .step(data-q="¿Dónde lo encuentran tus pacientes?")
          +field('Teléfono', 'telefono', { type: 'tel', placeholder: 'Ej. 452 987 6543', required: true })
          +field('Dirección completa', 'direccion', { placeholder: 'Calle, número, colonia, ciudad', required: true })

    +modal('modalEditarClinica', 'Configuración del consultorio')
      form.form#formEditarClinica(method="POST" data-action="/clinica/editar/{id}" data-toast="Cambios guardados" data-steps data-submit="Guardar cambios")
        .step(data-q="¿Cómo se llama el consultorio?")
          +field('Nombre de la clínica', 'nombre_clinica', { required: true, fill: 'nombre' })
        .step(data-q="¿Dónde lo encuentran tus pacientes?")
          +field('Teléfono', 'telefono', { type: 'tel', required: true, fill: 'telefono' })
          +field('Dirección completa', 'direccion', { required: true, fill: 'direccion' })
      form.danger-zone#formEliminarClinica(method="POST" data-action="/clinica/eliminar/{id}" data-confirm="Se eliminará el consultorio junto con todos sus pacientes y su inventario. Esta acción no se puede deshacer." data-confirm-ok="Eliminar consultorio" data-toast="Consultorio eliminado")
        button.btn.btn--danger-soft.btn--block(type="submit")
          +icon('trash', 16)
          | Eliminar consultorio

    +modal('modalPerfil', 'Mi perfil')
      form.form(action="/perfil/editar" method="POST" data-toast="Perfil actualizado" data-steps data-submit="Guardar cambios")
        .step(data-q="¿Cómo apareces en tus recetas?")
          +field('Nombre completo', 'nombre_doctor', { value: nombreDoc, required: true })
          +field('Cédula profesional', 'cedula', { value: (doctor && doctor.cedula) || '' })
        .step(data-q="¿Con qué correo inicias sesión?")
          +field('Correo electrónico', 'email', { type: 'email', value: (doctor && doctor.email) || '', required: true })
        .step(data-q="¿Quieres cambiar tu contraseña?" data-hint="Es opcional. Déjala vacía para conservar la actual.")
          +field('Nueva contraseña', 'password', { type: 'password', placeholder: 'Déjala vacía para no cambiarla', autocomplete: 'new-password' })

    +modal('modalConfirm', 'Confirmar acción')
      p.muted#confirmMsg
      .modal__actions
        button.btn.btn--ghost(type="button" data-close) Cancelar
        button.btn.btn--danger#confirmOk(type="button") Eliminar

    #toasts(aria-live="polite" aria-atomic="false")
