doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title DentaLink | Gestión Clínica
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
    link(rel="stylesheet", href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap")
    link(rel="stylesheet", href="/css/style.css")
    script(src="https://unpkg.com/lucide@latest")
    
  body
    .agenda-de-citas
      // BARRA LATERAL
      .barra-lateral
        .marca(style="display: flex; align-items: center; justify-content: center; height: auto !important; min-height: 80px; padding: 15px 0; margin-bottom: 15px; overflow: visible !important;")
          img(src="/img/logo.png" alt="DentaLink Logo" style="width: 150px; height: auto; object-fit: contain; display: block;")
        
        // ==========================================
        // SELECTOR DE CLÍNICAS DESPLEGABLE
        // ==========================================
        .selector-clinica-container(style="position: relative; margin-bottom: 20px;")
          .clinica(onclick="toggleMenuClinicas()" style="display: flex; align-items: center; gap: 12px; padding: 10px; background: #f8fafc; border-radius: 8px; cursor: pointer; border: 1px solid #e2e8f0; transition: all 0.2s;")
            i(data-lucide="building" style="width: 20px; height: 20px; color: #00A5C4;")
            .datos-de-clinica
              p.texto(style="margin: 0; font-weight: 600; color: #1e293b; font-size: 14px;") #{clinicaActiva ? clinicaActiva.nombre_clinica : 'Sin Clínica'}
              p.texto-2(style="margin: 0; font-size: 12px; color: #64748b;") Cambiar consultorio
            i(data-lucide="chevron-down" style="width: 16px; height: 16px; color: #94a3b8; margin-left: auto;")
          
          // Menú desplegable oculto
          #menuClinicas(style="display: none; position: absolute; top: 100%; left: 0; width: 100%; background: white; border: 1px solid #e2e8f0; border-radius: 8px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); margin-top: 5px; z-index: 100; overflow: hidden;")
            if misClinicas && misClinicas.length > 0
              each clinica in misClinicas
                // Fila de cada clínica con su botón de lápiz
                div(style=`display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #f1f5f9; ${clinicaActiva && clinicaActiva.id === clinica.id ? 'background: #f0fdfa;' : 'background: white;'}`)
                  a(href=`/cambiar-clinica/${clinica.id}` style=`flex-grow: 1; text-decoration: none; padding: 10px 15px; font-size: 13px; color: ${clinicaActiva && clinicaActiva.id === clinica.id ? '#0d9488' : '#1e293b'}; font-weight: ${clinicaActiva && clinicaActiva.id === clinica.id ? '600' : '400'};`)
                    | #{clinica.nombre_clinica}
                  
                  // Botón del Lápiz (Editar)
                  button(type="button" onclick=`abrirModalEditarClinica('${clinica.id}', '${clinica.nombre_clinica}', '${clinica.telefono}', '${clinica.direccion}')` style="background: none; border: none; cursor: pointer; color: #94a3b8; padding: 10px; margin-right: 5px; transition: color 0.2s;" onmouseover="this.style.color='#00A5C4'" onmouseout="this.style.color='#94a3b8'")
                    i(data-lucide="edit-2" style="width: 14px; height: 14px;")
            
            button(type="button" onclick="abrirModalNuevaClinica()" style="width: 100%; text-align: left; padding: 12px 15px; background: #f8fafc; border: none; color: #00A5C4; font-size: 13px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;")
              i(data-lucide="plus-circle" style="width: 14px; height: 14px;")
              | Registrar nueva clínica

        // NAVEGACIÓN
        .navegacion-principal
          p.etiqueta-de-menu ESPACIO CLÍNICO
          
          a(href="/" class=(pagina === 'agenda' ? 'opcion-de-navegacion' : 'opcion-de-navegacion-2') style="display: flex; align-items: center; gap: 12px; text-decoration: none;")
            i(data-lucide="calendar" style="width: 20px; height: 20px;")
            p(class=(pagina === 'agenda' ? 'texto-3' : 'texto-4') style="margin: 0;") Agenda
            
          a(href="/expediente" class=(pagina === 'pacientes' ? 'opcion-de-navegacion' : 'opcion-de-navegacion-2') style="display: flex; align-items: center; gap: 12px; text-decoration: none;")
            i(data-lucide="users" style="width: 20px; height: 20px;")
            p(class=(pagina === 'pacientes' ? 'texto-3' : 'texto-4') style="margin: 0;") Pacientes
            
          a(href="/inventario" class=(pagina === 'inventario' ? 'opcion-de-navegacion' : 'opcion-de-navegacion-2') style="display: flex; align-items: center; gap: 12px; text-decoration: none;")
            i(data-lucide="package" style="width: 20px; height: 20px;")
            p(class=(pagina === 'inventario' ? 'texto-3' : 'texto-4') style="margin: 0;") Inventario
            
          a(href="/receta" class=(pagina === 'recetas' ? 'opcion-de-navegacion' : 'opcion-de-navegacion-2') style="display: flex; align-items: center; gap: 12px; text-decoration: none;")
            i(data-lucide="file-text" style="width: 20px; height: 20px;")
            p(class=(pagina === 'recetas' ? 'texto-3' : 'texto-4') style="margin: 0;") Recetas
            
        .espaciador
        
        .ayuda(style="background: #f8fafc; padding: 15px; border-radius: 12px; margin-bottom: 15px;")
          i(data-lucide="help-circle" style="width: 20px; height: 20px; color: #64748b; margin-bottom: 10px;")
          p.texto(style="margin: 0 0 5px 0; font-weight: 600; font-size: 14px; color: #1e293b;") Estamos para ayudarte
          p.texto-9(style="margin: 0 0 10px 0; font-size: 12px; color: #64748b; line-height: 1.4;") Encuentra respuestas en nuestro centro de ayuda.
          a(href="#" style="color: #00A5C4; font-size: 13px; font-weight: 600; text-decoration: none;") Visitar centro de ayuda ↗
          
        p.texto-12(style="margin-top: 20px; font-size: 11px; color: #94a3b8; text-align: center;") DentaLink · Gestión clínica integral

      // ESPACIO DE TRABAJO (Área Derecha)
      .espacio-de-trabajo
        // BARRA SUPERIOR
        .barra-superior(style="display: flex; justify-content: space-between; align-items: center; padding: 15px 30px; border-bottom: 1px solid #e2e8f0; background: white;")
          .buscador(style="display: flex; align-items: center; gap: 10px; background: #f1f5f9; padding: 8px 15px; border-radius: 8px; width: 300px;")
            i(data-lucide="search" style="width: 18px; height: 18px; color: #94a3b8;")
            input(type="text" placeholder="Buscar paciente..." style="border: none; background: transparent; outline: none; font-family: 'Inter', sans-serif; font-size: 14px; color: #475569; width: 100%;")
            p.texto-2(style="margin: 0; background: white; padding: 2px 6px; border-radius: 4px; font-size: 11px; color: #94a3b8; border: 1px solid #e2e8f0;") ⌘ K
          
          div(style="display: flex; align-items: center; gap: 20px;")
            i(data-lucide="bell" style="width: 20px; height: 20px; color: #64748b; cursor: pointer;")
            .separador(style="width: 1px; height: 24px; background-color: #e2e8f0;")
            
            // ==========================================
            // PERFIL DEL DOCTOR (Un solo clic para Editar)
            // ==========================================
            div(style="display: flex; align-items: center; gap: 10px;")
              div(onclick="abrirModalEditarPerfil()" style="display: flex; align-items: center; gap: 10px; cursor: pointer; padding: 5px 10px; border-radius: 8px; transition: background 0.2s;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='transparent'" title="Editar mis datos")
                .avatar-del-doctor(style="width: 36px; height: 36px; border-radius: 50%; background-color: #00A5C4; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 14px;") Dr
                .perfil-del-doctor
                  p.texto(style="margin: 0; font-weight: 600; font-size: 14px; color: #1e293b;") Dr. #{doctor.nombre_doctor}
                  p.texto-2(style="margin: 0; font-size: 12px; color: #64748b;") Odontólogo
                i(data-lucide="edit-2" style="width: 16px; height: 16px; color: #64748b;")
              
              a(href="/cerrar-sesion" style="text-decoration: none; color: #dc2626; font-size: 13px; font-weight: 600; padding: 6px 12px; border: 1px solid #fca5a5; border-radius: 6px; background-color: #fef2f2; transition: all 0.2s; margin-left: 10px;") Cerrar Sesión

        block content

    // ==========================================
    // 1. MODAL PARA AÑADIR NUEVO CONSULTORIO
    // ==========================================
    #modalNuevaClinica.modal-overlay(style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); align-items: center; justify-content: center; z-index: 1000;")
      .modal-content(style="background: white; padding: 30px; border-radius: 16px; width: 400px; max-width: 90%; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1); position: relative;")
        button(type="button" onclick="cerrarModales()" style="position: absolute; top: 15px; right: 15px; background: none; border: none; font-size: 24px; color: #94a3b8; cursor: pointer; line-height: 1;") &times;
        h2(style="margin: 0 0 20px 0; color: #1e293b; font-size: 20px; font-weight: 700; text-align: center;") Registrar Nuevo Consultorio
        
        form(action="/clinica/nueva" method="POST" style="display: flex; flex-direction: column; gap: 15px;")
          div
            label(style="font-size: 12px; font-weight: 600; color: #475569;") Nombre de la Clínica
            input(type="text" name="nombre_clinica" placeholder="Ej. Consultorio Centro" required style="width: 100%; padding: 10px; border: 1px solid #e2e8f0; border-radius: 8px; margin-top: 4px; outline: none;")
          div
            label(style="font-size: 12px; font-weight: 600; color: #475569;") Teléfono
            input(type="text" name="telefono" placeholder="Ej. 452 987 6543" required style="width: 100%; padding: 10px; border: 1px solid #e2e8f0; border-radius: 8px; margin-top: 4px; outline: none;")
          div
            label(style="font-size: 12px; font-weight: 600; color: #475569;") Dirección Completa
            input(type="text" name="direccion" placeholder="Calle, Número, Colonia, Ciudad" required style="width: 100%; padding: 10px; border: 1px solid #e2e8f0; border-radius: 8px; margin-top: 4px; outline: none;")
          
          button(type="submit" style="margin-top: 10px; width: 100%; padding: 12px; background: #00A5C4; border: none; border-radius: 8px; cursor: pointer; color: white; font-weight: 600;") Crear Consultorio

    // ==========================================
    // 2. MODAL PARA EDITAR/ELIMINAR CONSULTORIO
    // ==========================================
    #modalEditarClinica.modal-overlay(style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); align-items: center; justify-content: center; z-index: 1000;")
      .modal-content(style="background: white; padding: 30px; border-radius: 16px; width: 400px; max-width: 90%; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1); position: relative;")
        button(type="button" onclick="cerrarModales()" style="position: absolute; top: 15px; right: 15px; background: none; border: none; font-size: 24px; color: #94a3b8; cursor: pointer; line-height: 1;") &times;
        h2(style="margin: 0 0 20px 0; color: #1e293b; font-size: 20px; font-weight: 700; text-align: center;") Configuración del Consultorio
        
        // FORMULARIO DE EDICIÓN
        form#formEditarClinica(method="POST" style="display: flex; flex-direction: column; gap: 15px;")
          div
            label(style="font-size: 12px; font-weight: 600; color: #475569;") Nombre de la Clínica
            input#editClinicaNombre(type="text" name="nombre_clinica" required style="width: 100%; padding: 10px; border: 1px solid #e2e8f0; border-radius: 8px; margin-top: 4px; outline: none;")
          div
            label(style="font-size: 12px; font-weight: 600; color: #475569;") Teléfono
            input#editClinicaTelefono(type="text" name="telefono" required style="width: 100%; padding: 10px; border: 1px solid #e2e8f0; border-radius: 8px; margin-top: 4px; outline: none;")
          div
            label(style="font-size: 12px; font-weight: 600; color: #475569;") Dirección Completa
            input#editClinicaDireccion(type="text" name="direccion" required style="width: 100%; padding: 10px; border: 1px solid #e2e8f0; border-radius: 8px; margin-top: 4px; outline: none;")
          
          button(type="submit" style="margin-top: 10px; width: 100%; padding: 12px; background: #00A5C4; border: none; border-radius: 8px; cursor: pointer; color: white; font-weight: 600;") Guardar Cambios

        // BOTÓN DE ELIMINAR CONSULTORIO (Independiente)
        div(style="margin-top: 20px; padding-top: 20px; border-top: 1px dashed #e2e8f0;")
          form#formEliminarClinica(method="POST" onsubmit="return confirm('¿Estás SEGURO de eliminar este consultorio? Perderás permanentemente a todos los pacientes y el inventario vinculados a él.');")
            button(type="submit" style="width: 100%; padding: 12px; background: #fee2e2; border: 1px solid #fca5a5; border-radius: 8px; cursor: pointer; color: #ef4444; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 8px; transition: background 0.2s;" onmouseover="this.style.background='#fecaca'" onmouseout="this.style.background='#fee2e2'")
              i(data-lucide="trash-2" style="width: 16px; height: 16px;")
              | Eliminar Consultorio

    // ==========================================
    // 3. MODAL PARA EDITAR DATOS PERSONALES
    // ==========================================
    #modalEditarPerfil.modal-overlay(style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); align-items: center; justify-content: center; z-index: 1000;")
      .modal-content(style="background: white; padding: 30px; border-radius: 16px; width: 400px; max-width: 90%; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1); position: relative;")
        button(type="button" onclick="cerrarModales()" style="position: absolute; top: 15px; right: 15px; background: none; border: none; font-size: 24px; color: #94a3b8; cursor: pointer; line-height: 1;") &times;
        h2(style="margin: 0 0 20px 0; color: #1e293b; font-size: 20px; font-weight: 700; text-align: center;") Datos del Médico
        
        form(action="/perfil/editar" method="POST" style="display: flex; flex-direction: column; gap: 15px;")
          div
            label(style="font-size: 12px; font-weight: 600; color: #475569;") Nombre completo
            input(type="text" name="nombre_doctor" value=`${doctor.nombre_doctor}` required style="width: 100%; padding: 10px; border: 1px solid #e2e8f0; border-radius: 8px; margin-top: 4px; outline: none;")
          div
            label(style="font-size: 12px; font-weight: 600; color: #475569;") Cédula Profesional
            input(type="text" name="cedula" value=`${doctor.cedula || ''}` style="width: 100%; padding: 10px; border: 1px solid #e2e8f0; border-radius: 8px; margin-top: 4px; outline: none;")
          div
            label(style="font-size: 12px; font-weight: 600; color: #475569;") Correo Electrónico
            input(type="email" name="email" value=`${doctor.email}` required style="width: 100%; padding: 10px; border: 1px solid #e2e8f0; border-radius: 8px; margin-top: 4px; outline: none;")
          div
            label(style="font-size: 12px; font-weight: 600; color: #475569;") Nueva Contraseña (Opcional)
            input(type="password" name="password" placeholder="Dejar en blanco para no cambiar" style="width: 100%; padding: 10px; border: 1px solid #e2e8f0; border-radius: 8px; margin-top: 4px; outline: none;")
          
          button(type="submit" style="margin-top: 10px; width: 100%; padding: 12px; background: #00A5C4; border: none; border-radius: 8px; cursor: pointer; color: white; font-weight: 600;") Actualizar Datos

    script.
      lucide.createIcons();
      
      // Control del menú desplegable de Clínicas
      function toggleMenuClinicas() {
        const menu = document.getElementById('menuClinicas');
        menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
      }

      // Cerrar menús si se hace clic fuera de ellos
      document.addEventListener('click', function(event) {
        const isClickInsideClinicas = document.querySelector('.selector-clinica-container').contains(event.target);
        if (!isClickInsideClinicas) {
          document.getElementById('menuClinicas').style.display = 'none';
        }
      });

      // Funciones para cerrar todos los Modales
      function cerrarModales() {
        document.querySelectorAll('.modal-overlay').forEach(modal => modal.style.display = 'none');
      }

      function abrirModalNuevaClinica() {
        document.getElementById('menuClinicas').style.display = 'none';
        document.getElementById('modalNuevaClinica').style.display = 'flex';
      }

      function abrirModalEditarClinica(id, nombre, telefono, direccion) {
        document.getElementById('menuClinicas').style.display = 'none';
        
        // Inyectamos los datos dinámicamente al formulario de EDICIÓN
        document.getElementById('formEditarClinica').action = '/clinica/editar/' + id;
        document.getElementById('editClinicaNombre').value = nombre;
        document.getElementById('editClinicaTelefono').value = telefono;
        document.getElementById('editClinicaDireccion').value = direccion;
        
        // Inyectamos el ID al formulario de ELIMINACIÓN
        document.getElementById('formEliminarClinica').action = '/clinica/eliminar/' + id;
        
        document.getElementById('modalEditarClinica').style.display = 'flex';
      }

      function abrirModalEditarPerfil() {
        document.getElementById('modalEditarPerfil').style.display = 'flex';
      }