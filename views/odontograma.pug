extends layout

mixin tooth(n)
  button.tooth-btn(type="button" data-pieza=n aria-label=`Pieza ${n}`)
    small= n
    span.tooth(id=`diente-${n}`)

block content
  - var ini = paciente ? ((paciente.nombre || '').charAt(0) + (paciente.apellidos || '').charAt(0)).toUpperCase() : ''
  .page
    a.back#volver(href="/expediente" data-prefetch)
      +icon('arrow-left', 16)
      span Pacientes

    header.page-head
      div
        h1.page-title Odontograma
        p.page-sub Elige una herramienta y toca el diente para registrar su estado.
      if paciente
        .row-actions
          span.avatar.avatar--soft= ini
          div
            strong #{paciente.nombre} #{paciente.apellidos}
            .sub #{paciente.telefono}
          a.btn.btn--ghost.btn--sm(href=`/expediente/detalle?paciente=${paciente.id}` data-prefetch) Ver expediente

    .odonto
      section.card
        .card__head
          h2 Dentición permanente
          span.badge 32 piezas
        .board
          .board__inner
            .arch
              .quad
                each n in [18, 17, 16, 15, 14, 13, 12, 11]
                  +tooth(n)
              .mid
              .quad
                each n in [21, 22, 23, 24, 25, 26, 27, 28]
                  +tooth(n)
            .arch.arch--lower
              .quad
                each n in [48, 47, 46, 45, 44, 43, 42, 41]
                  +tooth(n)
              .mid
              .quad
                each n in [31, 32, 33, 34, 35, 36, 37, 38]
                  +tooth(n)

      aside.card
        h2(style="font-size: 17px") Herramientas
        .tools#tools
          button.tool(type="button" data-tool="caries" aria-pressed="false")
            i
            | Caries
          button.tool(type="button" data-tool="resina" aria-pressed="false")
            i
            | Resina
          button.tool(type="button" data-tool="extraccion" aria-pressed="false")
            i
            | Extracción
          button.tool(type="button" data-tool="corona" aria-pressed="false")
            i
            | Corona
          button.tool.tool--wide(type="button" data-tool="sano" aria-pressed="false")
            i
            | Marcar como sano
        p.hint#hint Ninguna herramienta seleccionada

        h2(style="font-size: 15px; margin-top: 22px") Hallazgos registrados
        ul.finds#hallazgos

        .save-bar
          p.dirty#dirty Cambios sin guardar
          button.btn.btn--primary.btn--block#btnGuardar(type="button" data-paciente=(paciente ? paciente.id : ''))
            +icon('save', 16)
            span Guardar odontograma

  script#datos-odonto(type="application/json")!= JSON.stringify(hallazgosPrevios || {}).replace(/</g, '\\u003c')
  script.
    (() => {
      DL.ready(() => {
        const $ = (s) => document.querySelector(s);
        const desdeCita = new URLSearchParams(location.search).get('cita');
        if (desdeCita) { const v = $('#volver'); v.href = '/consulta?cita=' + encodeURIComponent(desdeCita); v.querySelector('span').textContent = 'Volver a la consulta'; }
        let previos = {};
        try { previos = JSON.parse($('#datos-odonto').textContent || '{}'); } catch (e) { /* vacío */ }
        const estado = (previos && typeof previos === 'object') ? Object.assign({}, previos) : {};
        const LABEL = { caries: 'Caries', resina: 'Resina', extraccion: 'Extracción', corona: 'Corona' };
        const BADGE = { caries: 'badge--danger', resina: 'badge--info', extraccion: '', corona: 'badge--warn' };
        let herramienta = null;
        let sucio = false;

        const pintar = (n) => {
          const el = document.getElementById('diente-' + n);
          if (el) el.className = 'tooth' + (estado[n] ? ' st-' + estado[n] : '');
        };
        const lista = () => {
          const ul = $('#hallazgos');
          const piezas = Object.keys(estado).sort((a, b) => a - b);
          ul.innerHTML = piezas.length
            ? piezas.map((n) => `<li class="find"><strong>Pieza ${DL.esc(n)}</strong><span class="badge ${BADGE[estado[n]] || ''}">${DL.esc(LABEL[estado[n]] || estado[n])}</span></li>`).join('')
            : '<li class="sub" style="padding:18px 0;text-align:center">Aún no hay hallazgos registrados.</li>';
        };
        const marcarSucio = (v) => { sucio = v; $('#dirty').classList.toggle('show', v); };

        Object.keys(estado).forEach(pintar);
        lista();

        // Herramientas
        const botones = document.querySelectorAll('.tool');
        botones.forEach((b) => b.addEventListener('click', () => {
          herramienta = herramienta === b.dataset.tool ? null : b.dataset.tool;
          botones.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.tool === herramienta)));
          $('#hint').textContent = herramienta ? `Aplicando: ${b.textContent.trim()}. Toca un diente.` : 'Ninguna herramienta seleccionada';
        }));

        // Dientes
        document.querySelectorAll('.tooth-btn').forEach((btn) => btn.addEventListener('click', () => {
          if (!herramienta) {
            const t = $('#tools');
            t.classList.remove('nudge'); void t.offsetWidth; t.classList.add('nudge');
            return DL.toast('Elige primero una herramienta.', 'error');
          }
          const n = btn.dataset.pieza;
          if (herramienta === 'sano' || estado[n] === herramienta) delete estado[n];   // tocar de nuevo = quitar
          else estado[n] = herramienta;
          pintar(n); lista(); marcarSucio(true);
        }));

        // Avisar si se intenta salir con cambios sin guardar
        DL.guard = () => (sucio ? DL.confirm('Tienes cambios sin guardar en el odontograma. Si sales ahora se perderán.', { ok: 'Salir sin guardar' }) : true);
        window.onbeforeunload = (e) => { if (sucio) { e.preventDefault(); return ''; } };

        // Guardar
        $('#btnGuardar').addEventListener('click', async function () {
          const btn = this;
          const pacienteId = btn.dataset.paciente;
          if (!pacienteId) return DL.toast('No se detectó al paciente.', 'error');
          btn.classList.add('is-busy');
          try {
            const r = await fetch('/odontograma/guardar', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pacienteId, hallazgos: estado }) });
            const j = await r.json().catch(() => ({}));
            if (!r.ok) throw new Error(j.mensaje || 'No se pudo guardar.');
            marcarSucio(false);
            DL.toast('Odontograma guardado');
          } catch (err) {
            DL.toast(err.message || 'Error de conexión al guardar.', 'error');
          } finally { btn.classList.remove('is-busy'); }
        });
      });
    })();
