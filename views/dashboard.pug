extends layout

block content
  .page
    header.page-head
      div
        h1.page-title Agenda
        p.page-sub Organiza tu día y acompaña cada sonrisa.
      a.btn.btn--ghost(href="/citas" data-prefetch)
        +icon('list', 18)
        | Ver todas las citas

    //- Cita en curso / siguiente: un clic y estás en la consulta
    section#hero.card.hero(aria-live="polite")
      .skeleton(style="height: 52px; width: 100%")

    .agenda
      section.card(aria-label="Calendario de citas")
        #calendario
        .legend
          span
            i(style="background: var(--primary)")
            | Pendientes
          span
            i(style="background: var(--ok)")
            | Completadas
          span
            i(style="background: var(--danger)")
            | Canceladas
          span.count#contador-mes

      aside.card(aria-label="Citas de hoy")
        .card__head
          h2 Citas de hoy
          span.badge.badge--tint#total-hoy 0
        p.hoy-date#fecha-hoy-texto
        #lista-citas-hoy.hoy-list
          .skeleton(style="height: 68px")
          .skeleton(style="height: 68px")
        a.back(href="/citas" data-prefetch style="margin: 14px 0 0") Ver todas las citas

  script.
    (() => {
      const $ = (s) => document.querySelector(s);
      const COLOR = { Pendiente: '#00A5C4', Completada: '#10B981', Cancelada: '#EF4444' };
      const mm = (t) => { const [h, m] = String(t).split(':'); return (parseInt(h, 10) || 0) * 60 + (parseInt(m, 10) || 0); };
      const hm = (t) => String(t).slice(0, 5);
      const nombre = (c) => (c.paciente ? `${c.paciente.nombre} ${c.paciente.apellidos}` : 'Paciente');
      let cal = null;
      let timer = null;
      DL.cleanups.push(() => { if (cal) cal.destroy(); clearInterval(timer); });

      DL.ready(() => {
        const hoy = new Date();
        const p2 = (n) => String(n).padStart(2, '0');
        const hoyISO = `${hoy.getFullYear()}-${p2(hoy.getMonth() + 1)}-${p2(hoy.getDate())}`;
        $('#fecha-hoy-texto').textContent = hoy.toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
        let deHoy = [];

        // ---- Tarjeta "cita en curso / siguiente"
        const pintarHero = () => {
          const el = $('#hero');
          if (!el) return;
          const pend = deHoy.filter((c) => c.estado === 'Pendiente');
          if (!pend.length) {
            el.className = 'card hero hero--idle';
            el.innerHTML = `<div class="hero__main"><h2>${deHoy.length ? 'Terminaste las citas de hoy' : 'Hoy no tienes citas'}</h2><p>${deHoy.length ? 'Buen trabajo. Puedes agendar la siguiente cuando quieras.' : 'Aprovecha para agendar a tus próximos pacientes.'}</p></div><button type="button" class="btn btn--primary" data-wizard>Agendar cita</button>`;
            return;
          }
          const n = new Date(); const ahora = n.getHours() * 60 + n.getMinutes();
          let c = pend.find((x) => mm(x.hora_inicio) <= ahora && ahora < mm(x.hora_fin));
          let etiqueta = 'En curso ahora', estado = 'live';
          if (!c) {
            c = pend.find((x) => mm(x.hora_inicio) > ahora);
            estado = 'next';
            if (c) { const falta = mm(c.hora_inicio) - ahora; etiqueta = falta <= 90 ? `Siguiente cita, en ${falta} min` : `Siguiente cita a las ${hm(c.hora_inicio)}`; }
          }
          if (!c) { c = pend[0]; etiqueta = 'Pendiente de atender'; estado = 'late'; }
          const otras = pend.length - 1;
          el.className = `card hero hero--${estado}`;
          el.innerHTML = `
            <div class="hero__main">
              <div class="hero__tag"><i></i>${DL.esc(etiqueta)}</div>
              <h2>${DL.esc(nombre(c))}</h2>
              <p>${DL.esc(hm(c.hora_inicio))} a ${DL.esc(hm(c.hora_fin))} h, ${DL.esc(c.motivo)}${otras > 0 ? `. Después ${otras === 1 ? 'tienes 1 cita más' : 'tienes ' + otras + ' citas más'} hoy.` : ''}</p>
            </div>
            <a class="btn btn--primary" href="/consulta?cita=${DL.esc(c.id)}" data-prefetch>${estado === 'live' ? 'Continuar consulta' : 'Atender ahora'}</a>`;
        };

        // ---- Ventana de reagendar / cancelar (desde el calendario)
        let actual = {};
        $('#modalAccionesCita').addEventListener('modal:open', (e) => {
          actual = (e.detail.trigger && e.detail.trigger.dataset) || {};
          $('#accionesResumen').textContent = `${actual.paciente || 'Paciente'}, ${hm(actual.inicio || '')} h, ${actual.motivo || ''}`;
        });
        // Cambiar fecha u hora: el mismo asistente, en modo edición (valida horarios ocupados)
        $('#btnReagendar').addEventListener('click', () => {
          DL.close($('#modalAccionesCita'));
          DL.wizard.open({ edit: actual });
        });

        // Un clic en una cita: pendiente -> opciones; completada -> consulta; cancelada -> aviso
        const abrir = (d) => {
          if (d.estado === 'Cancelada') return DL.toast('Esta cita fue cancelada.');
          if (d.estado === 'Completada') return DL.go('/consulta?cita=' + encodeURIComponent(d.id));
          DL.open('modalAccionesCita', { dataset: Object.assign({}, d, { inicio: hm(d.inicio), fin: hm(d.fin) }) });
        };

        Promise.all([fetch('/api/citas').then((r) => r.json()), DL.load(DL.FC)]).then(([citas]) => {
          if (!document.getElementById('calendario')) return;       // el usuario ya cambió de vista

          deHoy = citas.filter((c) => c.fecha === hoyISO).sort((a, b) => String(a.hora_inicio).localeCompare(String(b.hora_inicio)));
          $('#total-hoy').textContent = deHoy.length;
          $('#contador-mes').textContent = `${citas.length} citas en total`;
          pintarHero();
          timer = setInterval(pintarHero, 30000);

          const lista = $('#lista-citas-hoy');
          if (!deHoy.length) {
            lista.innerHTML = '<div class="empty" style="padding:28px 8px"><strong>Día libre</strong><span>No hay citas programadas para hoy.</span></div>';
          } else {
            lista.innerHTML = deHoy.map((c) => `
              <button type="button" class="cita is-${DL.esc(String(c.estado).toLowerCase())}" data-id="${DL.esc(c.id)}" data-estado="${DL.esc(c.estado)}">
                <span class="cita__top"><span class="cita__time">${DL.esc(hm(c.hora_inicio))}</span><span class="cita__state">${DL.esc(c.estado)}</span></span>
                <span class="cita__name">${DL.esc(nombre(c))}</span><br>
                <span class="cita__why">${DL.esc(c.motivo)}</span>
              </button>`).join('');
            lista.onclick = (e) => {
              const b = e.target.closest('.cita');
              if (!b) return;
              if (b.dataset.estado === 'Cancelada') return DL.toast('Esta cita fue cancelada.');
              DL.go('/consulta?cita=' + encodeURIComponent(b.dataset.id));
            };
          }

          cal = new FullCalendar.Calendar($('#calendario'), {
            initialView: 'dayGridMonth',
            locale: 'es',
            height: 'auto',
            nowIndicator: true,
            dayMaxEvents: 3,
            allDayText: 'Todo el día',
            moreLinkText: (n) => `+${n} más`,
            headerToolbar: { left: 'prev,next today', center: 'title', right: 'dayGridMonth,timeGridWeek,timeGridDay' },
            buttonText: { today: 'Hoy', month: 'Mes', week: 'Semana', day: 'Día' },
            events: citas.map((c) => ({
              id: c.id,
              title: `${nombre(c)} - ${c.motivo}`,
              start: `${c.fecha}T${c.hora_inicio}`,
              end: `${c.fecha}T${c.hora_fin}`,
              backgroundColor: COLOR[c.estado] || COLOR.Pendiente,
              extendedProps: { d: { id: c.id, pacienteId: c.pacienteId, estado: c.estado, fecha: c.fecha, inicio: c.hora_inicio, fin: c.hora_fin, motivo: c.motivo, paciente: nombre(c) } }
            })),
            dateClick: (info) => DL.wizard.open({ fecha: info.dateStr.slice(0, 10) }),
            eventClick: (info) => abrir(info.event.extendedProps.d)
          });
          cal.render();
        }).catch((err) => {
          console.error('Error cargando la agenda:', err);
          $('#hero').innerHTML = '<div class="hero__main"><h2>No se pudo cargar la agenda</h2><p>Revisa tu conexión y recarga la página.</p></div>';
          $('#lista-citas-hoy').innerHTML = '';
        });
      });
    })();

block modals
  +modal('modalAccionesCita', 'Opciones de la cita')
    p.muted#accionesResumen(style="margin: -6px 0 16px")
    .stack
      a.btn.btn--primary.btn--block(data-href="/consulta?cita={id}" href="#" style="height: 46px")
        +icon('smile', 18)
        | Atender consulta
      button.btn.btn--ghost.btn--block#btnReagendar(type="button" style="height: 44px")
        +icon('calendar', 16)
        | Cambiar fecha u hora
      form(method="POST" data-action="/cita/cancelar/{id}" data-confirm="¿Cancelar esta cita? Seguirá visible en el calendario como cancelada." data-confirm-ok="Cancelar cita" data-toast="Cita cancelada")
        button.btn.btn--danger-soft.btn--block(type="submit" style="height: 44px")
          +icon('x', 16)
          | Cancelar cita
